generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  role          String   @default("BUYER")
  name          String
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  producer           Producer?
  orders             Order[]
  reviews            Review[]
  reports            Report[]
  buyerConversations Conversation[] @relation("ConversationBuyer")
  adminConversations Conversation[] @relation("ConversationAdmin")
  sentMessages       Message[]      @relation("SentMessages")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Producer {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  businessNameSi     String
  description        String?
  descriptionSi      String?
  location           String
  district           String
  phone              String
  verificationStatus String    @default("PENDING")
  verifiedAt         DateTime?
  rating             Float     @default(0)
  totalReviews       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products           Product[]
  offers             Offer[]
  conversations      Conversation[]
}

model Category {
  id                String   @id @default(cuid())
  name              String
  nameSi            String
  slug              String   @unique
  description       String?
  descriptionSi     String?
  image             String?
  markupPercentage  Float    @default(15)
  createdAt         DateTime @default(now())

  products          Product[]
}

model Product {
  id            String   @id @default(cuid())
  producerId    String
  producer      Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  nameSi        String
  description   String
  descriptionSi String
  price         Float
  originalPrice Float?
  unit          String
  unitSi        String
  images        String   @default("[]")
  stock         Int      @default(0)
  rating        Float    @default(0)
  totalReviews  Int      @default(0)
  active        Boolean  @default(true)
  flagged       Boolean  @default(false)
  sourceUrl     String?
  sourceSite    String?
  lastSyncAt    DateTime?
  syncStatus    String?  @default("paused")
  externalPrice Float?
  externalStock String?
  slug          String?  @unique
  brandLogoUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  reports       Report[]
  syncLogs      StockSyncLog[]
  resellerSource ResellerSource?
  conversations Conversation[]
  creative      ProductCreative?
}

model ProductCreative {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl   String
  status     String   @default("PENDING") // PENDING, ACTIVE
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  approvedAt DateTime?
  updatedAt  DateTime @updatedAt

  shares     CreativeShare[]
}

model CreativeShare {
  id         String          @id @default(cuid())
  creativeId String
  creative   ProductCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  channel    String // facebook, whatsapp, copy
  createdAt  DateTime        @default(now())
}

model StockSyncLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  oldPrice  Float?
  newPrice  Float?
  oldStock  String?
  newStock  String?
  createdAt DateTime @default(now())
}

model ResellerSource {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceUrl       String
  sourceDomain    String
  sourceName      String?
  sourcePrice     Float
  sourceStock     Int?
  sourceStatus    String   @default("ACTIVE") // ACTIVE, OUT_OF_STOCK, UNREACHABLE, REMOVED
  sourceRawData   String?
  lastScrapedAt   DateTime?
  lastSyncError   String?
  syncFailCount   Int      @default(0)
  requiresReview  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScraperDomainProfile {
  id                     String   @id @default(cuid())
  domain                 String   @unique
  strategy               String   @default("json-ld")
  selectorConfig         String?
  requiresJsRender       Boolean  @default(true)
  supplierWhatsAppNumber String?
  lastVerifiedAt         DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Order {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  status                 String   @default("PENDING")
  totalAmount            Float
  paymentMethod          String
  paymentDone            Boolean  @default(false)
  shippingName           String
  shippingPhone          String
  shippingAddress        String
  shippingCity           String
  notes                  String?
  forwardedToSupplierAt  DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  items                  OrderItem[]
  conversations          Conversation[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Offer {
  id              String   @id @default(cuid())
  producerId      String
  producer        Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  title           String
  titleSi         String
  description     String
  descriptionSi   String
  discountPercent Int
  startDate       DateTime
  endDate         DateTime
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Conversation {
  id         String    @id @default(cuid())
  buyerId    String?
  adminId    String?
  producerId String
  productId  String?
  orderId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  buyer      User?     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  admin      User?     @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  producer   Producer  @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([buyerId])
  @@index([adminId])
  @@index([producerId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}
