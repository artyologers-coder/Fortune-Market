# Database (PostgreSQL - Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Vercel Cron - protects /api/cron/sync (must match Vercel env var)
CRON_SECRET="generate-a-random-secret"

# SMS OTP Provider (replace with real provider credentials)
# Current implementation uses a mock stub — see src/lib/sms-provider.ts
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""

# Payment Gateway (stubbed — see src/lib/payment-gateway.ts)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# File uploads (local storage by default)
UPLOAD_DIR="./public/uploads"

# AI Scraper (optional - for enhanced product extraction)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# AI_SCRAPER_MODEL="gpt-4o-mini"

# Reseller Sync Worker
RESYNC_INTERVAL_MINUTES=30
RESYNC_FAIL_BACKOFF_MINUTES=360
PRICE_CHANGE_THRESHOLD_PERCENT=20
RESYNC_DOMAIN_DELAY_MS=5000